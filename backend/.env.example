# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:8081

# PostgreSQL (the included Docker setup exposes this database)
DATABASE_URL=postgresql://miniledger:miniledger@localhost:5432/miniledger

# Authentication secrets: replace both with long random values.
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-a-different-32-character-secret
JWT_EXPIRES_IN_SECONDS=604800

# Mock OTP behavior
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
